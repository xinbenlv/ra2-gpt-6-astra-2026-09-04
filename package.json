{
  "name": "red-alert-2-skirmish",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --import tsx --test src/game/*.test.ts scripts/maps/*.test.ts tests/*.test.ts",
    "assets:setup": "node --import tsx scripts/setup-assets.ts",
    "assets:check": "node --import tsx scripts/setup-assets.ts --check",
    "repo:check": "node --import tsx scripts/check-source-only.ts",
    "repo:hooks": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.4"
  },
  "dependencies": {
    "7z-wasm": "1.2.0"
  }
}
